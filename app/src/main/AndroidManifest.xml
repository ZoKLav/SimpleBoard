<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />



    <application
        android:allowBackup="false"
        android:supportsRtl="true"
        android:label="SimpleBoard"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="SimpleBoard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ShortcutEditorActivity" android:exported="false" />
        <activity android:name=".DictionaryActivity" android:exported="false" />
        <activity android:name=".ThemeActivity" android:exported="false" />
        <activity android:name=".TypingSettingsActivity" android:exported="false" />
        <activity android:name=".LayoutSettingsActivity" android:exported="false" />
        <activity android:name=".PopupSettingsActivity" android:exported="false" />
        <activity android:name=".AppearanceSettingsActivity" android:exported="false" />
        <activity android:name=".VoiceSettingsActivity" android:exported="false" />
        <activity android:name=".PrivacySettingsActivity" android:exported="false" />

        <service
            android:name=".SimpleBoardService"
            android:label="SimpleBoard"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
